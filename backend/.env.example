# === DATABASE ===
DATABASE_URL=sqlite+aiosqlite:///./smartprocure.db
# DATABASE_URL=postgresql+asyncpg://smartprocure:password@localhost:5432/smartprocure

# === RUNTIME ===
# development | staging | production
ENVIRONMENT=development

# === JWT ===
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-random-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# === GOOGLE GEMINI ===
GEMINI_API_KEY=your-gemini-api-key-here

# === CORS ===
# JSON array of allowed origins (no wildcard in production).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# === CHROMA DB ===
CHROMA_PERSIST_DIR=./vectordb

# === UPLOAD ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# === RAG ===
RAG_TOP_K=5
CONFIDENCE_THRESHOLD=0.70

# === EMBEDDING MODEL ===
# Multilingual model. Change it only together with a full re-index:
#   delete backend/vectordb, then run python seed_knowledge_base.py
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10

# === REFRESH TOKENS ===
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# === LOGGING ===
LOG_LEVEL=INFO
